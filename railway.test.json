{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm build",
    "watchPatterns": [
      "src/**",
      "tests/**",
      "package.json",
      "pnpm-lock.yaml",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm test",
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0,
    "sleepApplication": false
  }
}
